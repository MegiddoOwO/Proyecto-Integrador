{
  "extraKnownMarketplaces": {
    "voltagent-subagents": {
      "source": { "source": "github", "repo": "VoltAgent/awesome-claude-code-subagents" }
    },
    "claude-code-workflows": {
      "source": { "source": "github", "repo": "wshobson/agents" }
    },
    "anthropic-agent-skills": {
      "source": { "source": "github", "repo": "anthropics/skills" }
    }
  },
  "enabledPlugins": {
    "voltagent-research@voltagent-subagents": true,
    "voltagent-qa-sec@voltagent-subagents": true,
    "documentation-generation@claude-code-workflows": true,
    "document-skills@anthropic-agent-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["bgpt", "paper-search"],
  "permissions": {
    "allow": [
      "Bash(latexmk:*)",
      "Bash(biber:*)",
      "Bash(latexindent:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "WebFetch(domain:api.crossref.org)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:api.openalex.org)",
      "mcp__bgpt__search_papers",
      "mcp__paper-search__search_crossref",
      "mcp__paper-search__get_crossref_paper_by_doi",
      "mcp__paper-search__search_openalex",
      "mcp__paper-search__search_semantic",
      "mcp__paper-search__search_papers",
      "mcp__paper-search__search_arxiv",
      "mcp__paper-search__search_dblp",
      "mcp__paper-search__search_doaj",
      "mcp__paper-search__search_google_scholar"
    ],
    "deny": [
      "mcp__paper-search__download_scihub",
      "mcp__paper-search__download_with_fallback",
      "Edit(trabajo_original_backup.tex)",
      "Write(trabajo_original_backup.tex)",
      "Bash(rm *.tex)",
      "Bash(rm *.bib)",
      "Bash(rm -r secciones*)",
      "Bash(rm -r apendices*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compilar.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
